# Bookie environment settings.
# Generated from apps/api/src/config/params.ts: run `pnpm generate` from the repository root.
# Copy to .env and fill in the secrets. Never commit .env.
# Numbers marked "hypothesis" are defaults to be measured, not facts (spec parameter rule).

# Runtime environment. [BE-1]
NODE_ENV=development

# Port the API listens on. [BE-1]
API_PORT=3001

# Frontend origin allowed by CORS and used in reset-password links. [BE-1]
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection string. The default matches docker-compose.yml. [D-005]
DATABASE_URL=postgresql://bookie:bookie@localhost:5432/bookie

# Redis connection string. The default matches docker-compose.yml. [D-005]
REDIS_URL=redis://localhost:6379

# Secret for signing access tokens, at least 32 characters. Required in production. In development a random one is generated at start-up. [D-001]
AUTH_TOKEN_SECRET=

# Google Books API key. Ratings and metadata, fetched live only, never stored. [D-003]
GOOGLE_BOOKS_API_KEY=

# Hardcover personal access token with read-only scopes. Aggregate ratings only. [D-003]
HARDCOVER_API_TOKEN=

# Gemini API key for LLM and vision steps. Server-side only. [D-005]
GEMINI_API_KEY=

# SMTP host. [D-001]
SMTP_HOST=localhost

# SMTP port (Mailpit: 1025). [D-001]
SMTP_PORT=1025

# SMTP user, if any. [D-001]
SMTP_USER=

# SMTP password, if any. [D-001]
SMTP_PASSWORD=

# Sender address for password-reset emails. [D-001]
MAIL_FROM=Bookie <no-reply@bookie.local>

# Access token lifetime. [D-001]
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime. Rotated on every use. [D-001]
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Password-reset link lifetime. Single use. [D-001]
AUTH_RESET_TOKEN_TTL_MINUTES=30

# Minimum password length. [D-001]
AUTH_PASSWORD_MIN_LENGTH=10

# Maximum password length. [D-001]
AUTH_PASSWORD_MAX_LENGTH=128

# Longest display name accepted at registration. [BE-3]
AUTH_DISPLAY_NAME_MAX_LENGTH=50

# Send the refresh cookie with the Secure flag. Browsers accept Secure cookies on http://localhost, so keep this true. [D-001]
AUTH_COOKIE_SECURE=true

# argon2id memory cost in KiB. [D-001, OWASP Password Storage Cheat Sheet]
AUTH_ARGON2_MEMORY_KIB=19456

# argon2id time cost (iterations). [D-001, OWASP Password Storage Cheat Sheet]
AUTH_ARGON2_ITERATIONS=2

# argon2id parallelism. [D-001, OWASP Password Storage Cheat Sheet]
AUTH_ARGON2_PARALLELISM=1

# Trust the first proxy's X-Forwarded-For header for the client IP (per-IP throttling). Turn on only behind a reverse proxy. [BE-3]
TRUST_PROXY=false

# Prefix for every Redis key, so several environments can share one Redis. [BE-3]
REDIS_KEY_PREFIX=bookie:

# Register, login and forgot-password requests allowed per IP and per email in one window. [D-001 (hypothesis)]
RATE_LIMIT_AUTH_MAX=10

# Window for RATE_LIMIT_AUTH_MAX. [D-001 (hypothesis)]
RATE_LIMIT_AUTH_WINDOW_SECONDS=900

# Readers may skip onboarding. Setting false requires changing ONB-2 first. [D-002]
ONBOARDING_ALLOW_SKIP=true

# Rated books needed for a confident personal match. [Spec 6, D-008]
TASTE_MIN_RATED_FOR_CONFIDENCE=10

# Below this many rated books, no personal match is shown (MODEL-4). [Spec 6, D-008]
TASTE_HARD_FLOOR=3

# Serve this release version instead of the shipped one (for tests and rollbacks). Empty = the shipped model. [D-024]
TASTE_MODEL_VERSION=

# High confidence needs at least this many of the reader's ratings among the books the learned model knows. [D-024 (hypothesis: the learning curve still improves up to 40)]
PERSONAL_CONFIDENCE_HIGH_RATINGS=40

# How many of the reader's most similar rated books explain a score. [D-024]
PERSONAL_SIMILAR_BOOKS=3

# Largest accepted rating export file. [D-018 (hypothesis)]
IMPORT_MAX_BYTES=10000000

# Most rated books accepted from one import file. [D-018 (hypothesis)]
IMPORT_MAX_ROWS=5000

# Title match (trigram similarity) an imported row needs to be matched without asking. Stricter than a scan, since nobody looks at it. [Spec 6, D-018 (hypothesis)]
IMPORT_MIN_TITLE_MATCH=0.8

# Author match an imported row needs to be matched without asking. [D-018 (hypothesis)]
IMPORT_MIN_AUTHOR_MATCH=0.6

# Imports allowed per reader per day. [D-018 (hypothesis)]
IMPORT_MAX_PER_DAY=10

# An import still processing after this long (for example after a restart) is resumed. [D-018]
IMPORT_STALE_SECONDS=120

# Rating and questionnaire saves allowed per reader per minute. Each save is a new profile version. [D-018 (hypothesis)]
RATING_SAVES_PER_MINUTE=120

# Books returned by the quick-rate list and catalog search. [D-018]
QUICK_RATE_LIST_SIZE=20

# Candidates shown for a search or scan. [Spec 6]
SEARCH_MAX_CANDIDATES=3

# Longest side the client resizes a cover photo to before upload. [Spec 6, D-008]
SCAN_RESIZE_MAX_PX=1024

# Largest accepted scan upload. Larger uploads are rejected before processing (DISC-4). [Spec 6 (hypothesis)]
SCAN_MAX_UPLOAD_BYTES=2000000

# Scans allowed per reader per day. [Spec 6 (hypothesis)]
SCAN_DAILY_QUOTA=20

# Title match (trigram similarity, computed in code) a catalog book needs for a scan to count as identified. Below it the scan is uncertain (DISC-2). [Spec 6, D-017 (hypothesis)]
SCAN_MIN_CONFIDENCE=0.7

# Author match a catalog book needs, when the cover shows an author, to count as plausible. [D-017 (hypothesis)]
SCAN_AUTHOR_MIN_MATCH=0.6

# Timeout for reading one cover with the vision model. [D-017 (hypothesis)]
SCAN_TIMEOUT_MS=20000

# Model that reads cover photos (title, author, whether it is a book). [D-017]
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Lowest match score (trigram similarity, 0 to 1) for a catalog book to be a candidate. [Spec 6, D-017 (hypothesis)]
SEARCH_MIN_SCORE=0.4

# If no catalog book matches at least this well, Open Library is searched too (spec 6: stored books first, then external metadata). [Spec 6, D-017 (hypothesis)]
SEARCH_EXTERNAL_BELOW_SCORE=0.5

# How much the dataset rating count lifts a match in the ranking (0 turns it off). [D-017 (hypothesis)]
SEARCH_POPULARITY_WEIGHT=0.1

# Database time limit for one catalog search. [D-017 (hypothesis)]
SEARCH_TIMEOUT_MS=3000

# Searches allowed per reader per minute (protects Open Library from repeated lookups). [D-017 (hypothesis)]
SEARCH_RATE_LIMIT_PER_MINUTE=60

# Search Open Library when the catalog has no good match. [D-003]
OPEN_LIBRARY_ENABLED=true

# User-Agent sent to Open Library, which asks apps to identify themselves. Adding a contact email raises its limit to 3 requests per second. [D-003, docs/DATA_SOURCES.md]
OPEN_LIBRARY_USER_AGENT=Bookie/0.1 (portfolio project; https://github.com/xExz135/Bookie)

# Minimum time between Open Library requests (1 per second without a contact email). [D-003, docs/DATA_SOURCES.md]
OPEN_LIBRARY_MIN_INTERVAL_MS=1000

# Time limit for one source to answer for one book, across all its requests (an ISBN lookup, then a search, then ratings). Past it the source is reported as failed. [Spec 8, spec 10 cold-analysis target (hypothesis)]
SOURCE_DEADLINE_MS=12000

# Title similarity (pg_trgm scale) a live source result needs to count as the same book. 0.75 keeps box sets ("The Hunger Games Trilogy", 0.71) out. [D-020 (hypothesis; measure with sources:check)]
SOURCE_MATCH_MIN_TITLE=0.75

# Author similarity a live source result needs to count as the same book. [D-020 (hypothesis; measure with sources:check)]
SOURCE_MATCH_MIN_AUTHOR=0.5

# Results asked for when Open Library or Hardcover is searched by title and author. [D-020 (hypothesis)]
SOURCE_SEARCH_RESULTS=5

# Ask Google Books for ratings. Off by default: it matched 0 of the 12 most-rated books on 2026-10-21 (ISBN search returns nothing, and only the same edition may be used). Also needs GOOGLE_BOOKS_API_KEY. [D-020 (owner, 2026-10-21)]
GOOGLE_BOOKS_ENABLED=false

# Volumes asked for per Google Books search. Only the one with the edition ISBN is used, so more results mean more chances to find it. [D-020, docs/DATA_SOURCES.md test log]
GOOGLE_BOOKS_MAX_RESULTS=20

# Minimum time between Google Books requests (the free quota is per day). [D-020 (hypothesis)]
GOOGLE_BOOKS_MIN_INTERVAL_MS=250

# Minimum time between Hardcover requests (free plan: 60 a minute, burst 10). [D-003, docs/DATA_SOURCES.md]
HARDCOVER_MIN_INTERVAL_MS=1000

# Maximum reviews in the evidence set sent to the language model. [Spec 8, D-008]
EVIDENCE_MAX_REVIEWS=75

# Timeout for one source fetch. [Spec 8 (hypothesis)]
SOURCE_TIMEOUT_MS=8000

# pollAfterMs returned to the client while an analysis runs. [CONTRACT 4.4]
ANALYSIS_POLL_AFTER_MS=1500

# Analyses this API process runs at once; the rest wait in order. They run in the background, so leaving the page never cancels one (RES-1). [D-021 (hypothesis)]
ANALYSIS_MAX_CONCURRENT=2

# Run trait extraction and the public summary at the same time; they read the same evidence and not each other. [D-025 (blocker 7: cold latency)]
ANALYSIS_PARALLEL_MODEL_STEPS=true

# How often an analysis waiting for another analysis's build of the same book checks again (PERF-2). [D-025 (hypothesis)]
PUBLIC_BUILD_WAIT_POLL_MS=500

# A build claim older than this is treated as abandoned (for example the process stopped), so another analysis may build. [D-025 (hypothesis: longer than a slow cold build)]
PUBLIC_BUILD_CLAIM_TTL_SECONDS=180

# On start-up, resume analyses that were running when the API stopped (RES-1). Never done when NODE_ENV is test, because test apps share one database. [D-021]
ANALYSIS_RECOVER_ON_START=true

# Usable reviews with text needed for evidence to count as sufficient; fewer is limited (spec 8). Also the count for medium public confidence. [Spec 8, D-021 (hypothesis)]
EVIDENCE_SUFFICIENT_REVIEWS=10

# Usable reviews with text needed for high public evidence confidence, when no source failed and praise and complaints are both present. [Spec 4, D-021 (hypothesis)]
PUBLIC_CONFIDENCE_HIGH_REVIEWS=40

# Model for the written summary, praise and complaints (spec 10: the small model unless measurement shows the larger one is needed). [D-021, H2]
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite

# New analyses a reader may start per hour. [Spec 12 (hypothesis)]
RATE_LIMIT_ANALYSES_PER_HOUR=30

# Delete-my-data attempts per reader per hour. Each asks for the password, so this also limits password guessing. [D-022 (hypothesis)]
RATE_LIMIT_DELETE_DATA_PER_HOUR=5

# Manual review refreshes a reader may request per book per day. [Spec 10 (hypothesis)]
REFRESH_PER_BOOK_PER_DAY=3

# Reviews shorter than this are not used as written evidence. [Spec 8 (hypothesis)]
EVIDENCE_MIN_REVIEW_CHARS=80

# Longer reviews are cut to this length before use. [Spec 8 (hypothesis)]
EVIDENCE_MAX_REVIEW_CHARS=1000

# Comma-separated languages a review must be detected as to count as evidence. [Spec 8, D-015]
EVIDENCE_LANGUAGES=en

# Reviews per edition considered before selection (a stable sample for very popular books). [D-015 (hypothesis)]
EVIDENCE_CANDIDATE_LIMIT=400

# Embedding model for book representations (768 dimensions, fixed by migration). gemini-embedding-2 accepts longer input but its free-tier quota ran out after about 47,000 tokens (D-015). [D-015]
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Smaller model used for trait extraction (spec 10: small model first). [D-015, H2]
GEMINI_TRAIT_MODEL=gemini-3.5-flash-lite

# Larger model compared against the smaller one for trait extraction (H2). [D-015, H2]
GEMINI_TRAIT_MODEL_LARGE=gemini-3.5-flash

# Timeout for one Gemini request. [D-015 (hypothesis)]
GEMINI_TIMEOUT_MS=60000

# Client-side request pacing to stay under the API rate limit. [D-015 (hypothesis)]
GEMINI_MAX_REQUESTS_PER_MINUTE=30

# Client-side cap on estimated input tokens per minute. The free tier rejected bursts of about 60,000 tokens a minute (D-015). [D-015 (hypothesis, measured 2026-10-21)]
GEMINI_TOKENS_PER_MINUTE=30000

# Retries after an overloaded, unavailable or rate-limited response. Separate from the single retry for invalid output (spec 8). [D-015 (hypothesis)]
GEMINI_TRANSIENT_RETRIES=2

# Selected reviews included in a book embedding next to its description. [Spec 7, D-015 (hypothesis)]
EMBEDDING_MAX_REVIEWS=20

# Embedding input is cut to this length (gemini-embedding-001 accepts 2,048 tokens, about 8,000 characters). [D-015]
EMBEDDING_MAX_CHARS=7000

# Books embedded per API request. [D-015 (hypothesis)]
EMBEDDING_BATCH_SIZE=5

# Reuse window for book metadata and covers (spec range 30 to 90). [Spec 10]
CACHE_METADATA_TTL_DAYS=60

# Reuse window for reviews and public analysis. [Spec 10]
CACHE_REVIEWS_TTL_DAYS=30

# How long a source failure is remembered before retrying (spec range 5 to 15). [Spec 10]
CACHE_SOURCE_FAILURE_TTL_MINUTES=10

# How long an empty source result is remembered before retrying. [Spec 10]
CACHE_SOURCE_EMPTY_TTL_HOURS=24

# --- Docker Compose (local services only) ---
POSTGRES_USER=bookie
POSTGRES_PASSWORD=bookie
POSTGRES_DB=bookie
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
