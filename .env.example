# Bookie environment settings.
# Generated from apps/api/src/config/params.ts: run `pnpm generate` from the repository root.
# Copy to .env and fill in the secrets. Never commit .env.
# Numbers marked "hypothesis" are defaults to be measured, not facts (spec parameter rule).

# Runtime environment. [BE-1]
NODE_ENV=development

# Port the API listens on. [BE-1]
API_PORT=3001

# Frontend origin allowed by CORS and used in reset-password links. [BE-1]
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection string. The default matches docker-compose.yml. [D-005]
DATABASE_URL=postgresql://bookie:bookie@localhost:5432/bookie

# Redis connection string. The default matches docker-compose.yml. [D-005]
REDIS_URL=redis://localhost:6379

# Secret for signing access tokens, at least 32 characters. Required in production. In development a random one is generated at start-up. [D-001]
AUTH_TOKEN_SECRET=

# Google Books API key. Ratings and metadata, fetched live only, never stored. [D-003]
GOOGLE_BOOKS_API_KEY=

# Hardcover personal access token with read-only scopes. Aggregate ratings only. [D-003]
HARDCOVER_API_TOKEN=

# Gemini API key for LLM and vision steps. Server-side only. [D-005]
GEMINI_API_KEY=

# SMTP host. [D-001]
SMTP_HOST=localhost

# SMTP port (Mailpit: 1025). [D-001]
SMTP_PORT=1025

# SMTP user, if any. [D-001]
SMTP_USER=

# SMTP password, if any. [D-001]
SMTP_PASSWORD=

# Sender address for password-reset emails. [D-001]
MAIL_FROM=Bookie <no-reply@bookie.local>

# Access token lifetime. [D-001]
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime. Rotated on every use. [D-001]
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Password-reset link lifetime. Single use. [D-001]
AUTH_RESET_TOKEN_TTL_MINUTES=30

# Minimum password length. [D-001]
AUTH_PASSWORD_MIN_LENGTH=10

# Maximum password length. [D-001]
AUTH_PASSWORD_MAX_LENGTH=128

# Register, login and forgot-password requests allowed per IP and per email in one window. [D-001 (hypothesis)]
RATE_LIMIT_AUTH_MAX=10

# Window for RATE_LIMIT_AUTH_MAX. [D-001 (hypothesis)]
RATE_LIMIT_AUTH_WINDOW_SECONDS=900

# Readers may skip onboarding. Setting false requires changing ONB-2 first. [D-002]
ONBOARDING_ALLOW_SKIP=true

# Rated books needed for a confident personal match. [Spec 6, D-008]
TASTE_MIN_RATED_FOR_CONFIDENCE=10

# Below this many rated books, no personal match is shown (MODEL-4). [Spec 6, D-008]
TASTE_HARD_FLOOR=3

# Candidates shown for a search or scan. [Spec 6]
SEARCH_MAX_CANDIDATES=3

# Longest side the client resizes a cover photo to before upload. [Spec 6, D-008]
SCAN_RESIZE_MAX_PX=1024

# Largest accepted scan upload. Larger uploads are rejected before processing (DISC-4). [Spec 6 (hypothesis)]
SCAN_MAX_UPLOAD_BYTES=2000000

# Scans allowed per reader per day. [Spec 6 (hypothesis)]
SCAN_DAILY_QUOTA=20

# Identification confidence below this is treated as uncertain (DISC-2). [Spec 6 (hypothesis)]
SCAN_MIN_CONFIDENCE=0.7

# Maximum reviews in the evidence set sent to the language model. [Spec 8, D-008]
EVIDENCE_MAX_REVIEWS=75

# Timeout for one source fetch. [Spec 8 (hypothesis)]
SOURCE_TIMEOUT_MS=8000

# pollAfterMs returned to the client while an analysis runs. [CONTRACT 4.4]
ANALYSIS_POLL_AFTER_MS=1500

# New analyses a reader may start per hour. [Spec 12 (hypothesis)]
RATE_LIMIT_ANALYSES_PER_HOUR=30

# Manual review refreshes a reader may request per book per day. [Spec 10 (hypothesis)]
REFRESH_PER_BOOK_PER_DAY=3

# Reviews shorter than this are not used as written evidence. [Spec 8 (hypothesis)]
EVIDENCE_MIN_REVIEW_CHARS=80

# Longer reviews are cut to this length before use. [Spec 8 (hypothesis)]
EVIDENCE_MAX_REVIEW_CHARS=1000

# Comma-separated languages a review must be detected as to count as evidence. [Spec 8, D-015]
EVIDENCE_LANGUAGES=en

# Reviews per edition considered before selection (a stable sample for very popular books). [D-015 (hypothesis)]
EVIDENCE_CANDIDATE_LIMIT=400

# Embedding model for book representations (768 dimensions, fixed by migration). gemini-embedding-2 accepts longer input but its free-tier quota ran out after about 47,000 tokens (D-015). [D-015]
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Smaller model used for trait extraction (spec 10: small model first). [D-015, H2]
GEMINI_TRAIT_MODEL=gemini-3.5-flash-lite

# Larger model compared against the smaller one for trait extraction (H2). [D-015, H2]
GEMINI_TRAIT_MODEL_LARGE=gemini-3.5-flash

# Timeout for one Gemini request. [D-015 (hypothesis)]
GEMINI_TIMEOUT_MS=60000

# Client-side request pacing to stay under the API rate limit. [D-015 (hypothesis)]
GEMINI_MAX_REQUESTS_PER_MINUTE=30

# Client-side cap on estimated input tokens per minute. The free tier rejected bursts of about 60,000 tokens a minute (D-015). [D-015 (hypothesis, measured 2026-10-21)]
GEMINI_TOKENS_PER_MINUTE=30000

# Retries after an overloaded, unavailable or rate-limited response. Separate from the single retry for invalid output (spec 8). [D-015 (hypothesis)]
GEMINI_TRANSIENT_RETRIES=2

# Selected reviews included in a book embedding next to its description. [Spec 7, D-015 (hypothesis)]
EMBEDDING_MAX_REVIEWS=20

# Embedding input is cut to this length (gemini-embedding-001 accepts 2,048 tokens, about 8,000 characters). [D-015]
EMBEDDING_MAX_CHARS=7000

# Books embedded per API request. [D-015 (hypothesis)]
EMBEDDING_BATCH_SIZE=5

# Reuse window for book metadata and covers (spec range 30 to 90). [Spec 10]
CACHE_METADATA_TTL_DAYS=60

# Reuse window for reviews and public analysis. [Spec 10]
CACHE_REVIEWS_TTL_DAYS=30

# How long a source failure is remembered before retrying (spec range 5 to 15). [Spec 10]
CACHE_SOURCE_FAILURE_TTL_MINUTES=10

# How long an empty source result is remembered before retrying. [Spec 10]
CACHE_SOURCE_EMPTY_TTL_HOURS=24

# --- Docker Compose (local services only) ---
POSTGRES_USER=bookie
POSTGRES_PASSWORD=bookie
POSTGRES_DB=bookie
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
