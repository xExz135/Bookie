{
  "endpoint": "POST /api/v1/auth/reset-password",
  "outcomes": {
    "success": { "status": 204, "body": null },
    "invalidOrExpiredLink": {
      "status": 400,
      "body": {
        "code": "VALIDATION_FAILED",
        "message": "Some fields are invalid.",
        "retryable": false,
        "fields": { "token": "This reset link is invalid or has expired." }
      }
    }
  }
}
