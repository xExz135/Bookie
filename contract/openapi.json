          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "RATE_LIMITED"
          }
        },
        "tags": [
          "discovery"
        ]
      }
    },
