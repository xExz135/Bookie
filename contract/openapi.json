    "/api/v1/books/search": {
      "get": {
        "operationId": "DiscoveryController_searchBooks",
        "parameters": [
          {
            "description": "Title, author, both, or an ISBN",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookSearchResult"
                }
              }
            },
            "description": "At most SEARCH_MAX_CANDIDATES books, one edition each. Never auto-selected."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "VALIDATION_FAILED"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
