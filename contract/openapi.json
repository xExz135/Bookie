{
  "components": {
    "schemas": {
      "AccessToken": {
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresInSeconds": {
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "accessToken",
          "expiresInSeconds"
        ],
        "type": "object"
      },
      "AnalysisStatus": {
        "enum": [
          "running",
          "complete",
          "partial",
          "failed"
        ],
        "type": "string"
      },
      "AuthSession": {
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresInSeconds": {
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "user": {
            "additionalProperties": false,
            "properties": {
              "displayName": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string"
              },
              "onboardingState": {
                "enum": [
                  "pending",
                  "skipped",
                  "completed"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "displayName",
              "onboardingState"
            ],
            "type": "object"
          }
        },
        "required": [
          "accessToken",
          "expiresInSeconds",
          "user"
        ],
        "type": "object"
      },
      "BookSearchResult": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "author": {
                  "nullable": true,
                  "type": "string"
                },
                "coverUrl": {
                  "nullable": true,
                  "type": "string"
                },
                "editionId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                },
                "format": {
                  "nullable": true,
                  "type": "string"
                },
                "language": {
                  "nullable": true,
                  "type": "string"
                },
                "publisher": {
                  "nullable": true,
                  "type": "string"
                },
                "subtitle": {
                  "nullable": true,
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "year": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "nullable": true,
                  "type": "integer"
                }
              },
              "required": [
                "editionId",
                "title",
                "subtitle",
                "author",
                "year",
                "language",
                "publisher",
                "format",
                "coverUrl"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "external": {
            "additionalProperties": false,
            "nullable": true,
            "properties": {
              "outcome": {
                "enum": [
                  "ok",
                  "empty",
                  "failed",
                  "rate_limited",
                  "not_permitted"
                ],
                "type": "string"
              },
              "source": {
                "enum": [
                  "open_library"
                ],
                "type": "string"
              }
            },
            "required": [
              "source",
              "outcome"
            ],
            "type": "object"
          }
        },
        "required": [
          "candidates",
          "external"
        ],
        "type": "object"
      },
      "Candidate": {
        "additionalProperties": false,
        "properties": {
          "author": {
            "nullable": true,
            "type": "string"
          },
          "coverUrl": {
            "nullable": true,
            "type": "string"
          },
          "editionId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "format": {
            "nullable": true,
            "type": "string"
          },
          "language": {
            "nullable": true,
            "type": "string"
          },
          "publisher": {
            "nullable": true,
            "type": "string"
          },
          "subtitle": {
            "nullable": true,
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "editionId",
          "title",
          "subtitle",
          "author",
          "year",
          "language",
          "publisher",
          "format",
          "coverUrl"
        ],
        "type": "object"
      },
      "ConfidenceLevel": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "type": "string"
      },
      "ErrorCode": {
        "enum": [
          "VALIDATION_FAILED",
          "UNAUTHENTICATED",
          "TOKEN_EXPIRED",
          "INVALID_CREDENTIALS",
          "NOT_FOUND",
          "RATE_LIMITED",
          "SCAN_QUOTA_EXCEEDED",
          "UPLOAD_TOO_LARGE",
          "UNSUPPORTED_TYPE",
          "NOT_A_BOOK",
          "UNREADABLE_IMAGE",
          "IDENTIFICATION_UNAVAILABLE",
          "SOURCES_UNAVAILABLE",
          "LLM_QUOTA_EXHAUSTED",
          "INVALID_MODEL_OUTPUT",
          "CONFLICT",
          "EMAIL_IN_USE",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "ErrorResponseDto": {
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Present only for VALIDATION_FAILED: field name to message.",
            "type": "object"
          },
          "message": {
            "description": "Safe default text. The frontend maps `code` to its own wording.",
            "type": "string"
          },
          "retryAfterSeconds": {
            "type": "number"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "type": "object"
      },
      "EvidenceState": {
        "enum": [
          "sufficient",
          "limited",
          "insufficient",
          "unavailable"
        ],
        "type": "string"
      },
      "FeedbackTarget": {
        "enum": [
          "public",
          "personal"
        ],
        "type": "string"
      },
      "FeedbackValue": {
        "enum": [
          "accurate",
          "not_for_me"
        ],
        "type": "string"
      },
      "ForgotPasswordRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "ModelId": {
        "enum": [
          "B0",
          "B1",
          "B2",
          "B3",
          "B4"
        ],
        "type": "string"
      },
      "PersonalMatchStatus": {
        "enum": [
          "done",
          "running",
          "failed",
          "skipped",
          "needs_taste_data",
          "below_floor"
        ],
        "type": "string"
      },
      "RegisterRequest": {
        "properties": {
          "displayName": {
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ],
        "type": "object"
      },
      "ResetPasswordRequest": {
        "properties": {
          "newPassword": {
            "maxLength": 128,
            "minLength": 10,
            "type": "string"
          },
          "token": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token",
          "newPassword"
        ],
        "type": "object"
      },
      "ScanResult": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "author": {
                  "nullable": true,
                  "type": "string"
                },
                "coverUrl": {
                  "nullable": true,
                  "type": "string"
                },
                "editionId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                },
                "format": {
                  "nullable": true,
                  "type": "string"
                },
                "language": {
                  "nullable": true,
                  "type": "string"
                },
                "publisher": {
                  "nullable": true,
                  "type": "string"
                },
                "subtitle": {
                  "nullable": true,
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "year": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "nullable": true,
                  "type": "integer"
                }
              },
              "required": [
                "editionId",
                "title",
                "subtitle",
                "author",
                "year",
                "language",
                "publisher",
                "format",
                "coverUrl"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "external": {
            "additionalProperties": false,
            "nullable": true,
            "properties": {
              "outcome": {
                "enum": [
                  "ok",
                  "empty",
                  "failed",
                  "rate_limited",
                  "not_permitted"
                ],
                "type": "string"
              },
              "source": {
                "enum": [
                  "open_library"
                ],
                "type": "string"
              }
            },
            "required": [
              "source",
              "outcome"
            ],
            "type": "object"
          },
          "outcome": {
            "enum": [
              "identified",
              "uncertain"
            ],
            "type": "string"
          },
          "recognized": {
            "additionalProperties": false,
            "properties": {
              "authors": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "subtitle": {
                "nullable": true,
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "subtitle",
              "authors"
            ],
            "type": "object"
          }
        },
        "required": [
          "outcome",
          "candidates",
          "recognized",
          "external"
        ],
        "type": "object"
      },
      "SourceOutcome": {
        "enum": [
          "ok",
          "empty",
          "failed",
          "rate_limited",
          "not_permitted"
        ],
        "type": "string"
      },
      "StepName": {
        "enum": [
          "resolve",
          "fetchReviews",
          "selectReviews",
          "extractTraits",
          "publicSummary",
          "evidenceConfidence",
          "personalMatch",
          "finalize"
        ],
        "type": "string"
      },
      "StepStatus": {
        "enum": [
          "pending",
          "running",
          "done",
          "failed",
          "skipped"
        ],
        "type": "string"
      },
      "TraitFit": {
        "enum": [
          "aligned",
          "conflicting",
          "unknown"
        ],
        "type": "string"
      },
      "TraitKey": {
        "enum": [
          "pace",
          "tone",
          "themes",
          "contentIntensity"
        ],
        "type": "string"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "onboardingState": {
            "enum": [
              "pending",
              "skipped",
              "completed"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "onboardingState"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
