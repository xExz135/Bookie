{
  "name": "bookie",
  "private": true,
  "description": "Book Verdict v2 (Team Bookie)",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm --filter @bookie/api generate && pnpm --filter @bookie/web generate",
    "generate:check": "pnpm --filter @bookie/api generate:check && pnpm --filter @bookie/web generate:check"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@scarf/scarf",
      "unrs-resolver"
    ],
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
